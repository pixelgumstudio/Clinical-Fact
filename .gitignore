# ============================================================================
# This repo only ships the API and the workspace packages it depends on
# (packages/shared, packages/types, packages/validation). Everything else —
# the mobile app, the design system, docs, scripts, design tokens — is
# intentionally excluded so it never gets pushed.
# ============================================================================

# Ignore everything at the root by default
/*

# Re-include root files needed to install/build the API workspace
!/package.json
!/package-lock.json
!/turbo.json
!/docker-compose.yml
!/.gitignore
!/.gitattributes
!/.npmrc

# Re-include apps/, but only the api app inside it
!/apps
/apps/*
!/apps/api

# Re-include packages/, but only the packages the API depends on
!/packages
/packages/*
!/packages/shared
!/packages/types
!/packages/validation

# ----------------------------------------------------------------------------
# Secrets / env files — never commit these, wherever they show up
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
google-credentials.json
*-credentials.json
service-account*.json
.gcp-credentials.json
ssl/
*.pem
*.crt
*.key

# ----------------------------------------------------------------------------
# Dependencies / build artifacts / logs (applies within the re-included dirs)
# ----------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# API runtime output
apps/api/uploads/

# Large ML/OCR data files
*.traineddata

# ----------------------------------------------------------------------------
# Ad-hoc debug/manual-test scripts and scratch output (not part of the API)
# ----------------------------------------------------------------------------
apps/api/test-*.js
apps/api/check-*.js
apps/api/diagnose-*.js
apps/api/verify-setup.js
apps/api/list-models.js
apps/api/clear-database.js
apps/api/*.txt

# Stray nested apps/api/apps artifact
/apps/api/apps/

# ----------------------------------------------------------------------------
# OS / editor cruft
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# AI Assistant settings
.claude/
