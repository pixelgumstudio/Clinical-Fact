# ============================================================================
# This repo ships the API, the mobile app, and the workspace packages they
# depend on (packages/shared, packages/types, packages/validation,
# packages/design-system). Docs, scripts, and design tokens outside those
# workspaces are intentionally excluded so they never get pushed.
# ============================================================================

# Ignore everything at the root by default
/*

# Re-include root files needed to install/build the API workspace
!/package.json
!/package-lock.json
!/turbo.json
!/docker-compose.yml
!/.gitignore
!/.gitattributes
!/.npmrc

# Re-include the CI/CD workflow directory
!/.github
!/.github/workflows

# Re-include apps/, but only the api and mobile apps inside it
!/apps
/apps/*
!/apps/api
!/apps/mobile

# Re-include packages/, but only the packages the API and mobile app depend on
!/packages
/packages/*
!/packages/shared
!/packages/types
!/packages/validation
!/packages/design-system

# ----------------------------------------------------------------------------
# Secrets / env files — never commit these, wherever they show up
# ----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
google-credentials.json
*-credentials.json
service-account*.json
.gcp-credentials.json
ssl/
*.pem
*.crt
*.key
*.jks
*.keystore

# ----------------------------------------------------------------------------
# Dependencies / build artifacts / logs (applies within the re-included dirs)
# ----------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# API runtime output
apps/api/uploads/

# Large ML/OCR data files
*.traineddata

# ----------------------------------------------------------------------------
# Ad-hoc debug/manual-test scripts and scratch output (not part of the API)
# ----------------------------------------------------------------------------
apps/api/test-*.js
apps/api/check-*.js
apps/api/diagnose-*.js
apps/api/verify-setup.js
apps/api/list-models.js
apps/api/clear-database.js
apps/api/*.txt

# Stray nested apps/api/apps artifact
/apps/api/apps/

# ----------------------------------------------------------------------------
# OS / editor cruft
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# AI Assistant settings
.claude/
