{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@clinicalfact/validation": ["../../packages/validation/dist", "../../packages/validation/src"],
      "@clinicalfact/validation/*": ["../../packages/validation/dist/*", "../../packages/validation/src/*"],
      "@clinicalfact/shared": ["../../packages/shared/dist", "../../packages/shared/src"],
      "@clinicalfact/shared/*": ["../../packages/shared/dist/*", "../../packages/shared/src/*"],
      "@clinicalfact/types": ["../../packages/types/dist", "../../packages/types/src"],
      "@clinicalfact/types/*": ["../../packages/types/dist/*", "../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  }
}
