{
  "expo": {
    "entryPoint": "./index.js",
    "name": "Clinical Fact",
    "slug": "clinicfact-app",
    "version": "1.0.0",
    "scheme": "clinicalfact",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#021627"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "1",
      "supportsTablet": true,
      "bundleIdentifier": "com.clinicalfact.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Clinical Fact uses your microphone to record audio lectures, meetings, or voice memos that are then transcribed into searchable notes.",
        "NSPhotoLibraryUsageDescription": "Clinical Fact accesses your photo library so you can attach images to your notes or upload document photos for AI-powered transcription.",
        "NSPhotoLibraryAddUsageDescription": "Clinical Fact saves exported notes and study materials to your photo library.",
        "NSCameraUsageDescription": "Clinical Fact uses your camera to capture document photos that are transcribed into notes using AI."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.clinicalfact.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MICROPHONE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": "1.0.0",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "pageAlignSharedLibraries": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021627"
        }
      ],
      "./plugins/withModularHeaders",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1894092196-8h06csvj08v1fpjv65c5u0tnvv7kcv6g"
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2950c359-bd5e-44e7-8144-5eb2251af225"
      }
    },
    "owner": "pixelgumstudio"
  }
}
