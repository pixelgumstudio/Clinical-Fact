{
  "expo": {
    "entryPoint": "./index.js",
    "name": "Clinical Fact",
    "slug": "clinicfact-app",
    "version": "1.0.6",
    "scheme": "clinicalfact",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#021627"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "6",
      "supportsTablet": false,
      "bundleIdentifier": "com.clinicalfact.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Clinical Fact uses your microphone to record audio lectures, meetings, or voice memos that are then transcribed into searchable notes.",
        "NSPhotoLibraryUsageDescription": "Clinical Fact accesses your photo library so you can attach images to your notes or upload document photos for AI-powered transcription.",
        "NSPhotoLibraryAddUsageDescription": "Clinical Fact saves exported notes and study materials to your photo library.",
        "NSCameraUsageDescription": "Clinical Fact uses your camera to capture document photos that are transcribed into notes using AI."
      }
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.clinicalfact.app",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MICROPHONE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.MICROPHONE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": "1.0.6",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "pageAlignSharedLibraries": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#021627"
        }
      ],
      "./plugins/withModularHeaders",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.370250130816-akc1qnurlop4l4730agoj20o6j8f81fm"
        }
      ],
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/favicon.png",
          "color": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "028b5df9-8331-46d9-857c-027ac1665769"
      }
    },
    "owner": "pixelgumstudioapps",
    "updates": {
      "url": "https://u.expo.dev/028b5df9-8331-46d9-857c-027ac1665769"
    }
  }
}
